{
  "schemaVersion": 1,
  "id": "cbbg",
  "version": "${version}",
  "name": "CBBG",
  "environment": "client",
  "entrypoints": {
    "preLaunch": ["com.qb20nh.cbbg.CbbgEarlyInit"],
    "client": ["com.qb20nh.cbbg.CbbgClient"],
    "modmenu": ["com.qb20nh.cbbg.compat.modmenu.CbbgModMenuApi"]
  },
  "languageAdapters": {
    "cbbg:early": "com.qb20nh.cbbg.CbbgLanguageAdapter"
  },
  "mixins": ["cbbg.${renderer_family}.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}${loader_upper_bound}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_minimum}${fabric_api_upper_bound}"
  }
}
